{
  "name": "contentbay",
  "version": "0.1.0",
  "description": "Official JavaScript/TypeScript SDK for ContentBay Headless CMS",
  "private": false,
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "lint": "eslint src --ext .ts",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "cms",
    "headless-cms",
    "graphql",
    "sdk",
    "content-api",
    "contentbay"
  ],
  "author": "ContentBay",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/contentbay/contentbay-sdk.git"
  },
  "homepage": "https://contentbay.io",
  "dependencies": {
    "graphql-request": "^7.0.1"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.61.0",
    "@typescript-eslint/parser": "^8.61.0",
    "eslint": "^8.56.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0"
  }
}
