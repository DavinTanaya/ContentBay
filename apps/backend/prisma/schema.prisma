generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               Int               @id @default(autoincrement())
  email            String            @unique
  firstName        String?
  lastName         String?
  password         String?
  picture          String?
  provider         String
  createdAt        DateTime          @default(now())
  createdModels    ContentModel[]    @relation("ModelCreator")
  updatedModels    ContentModel[]    @relation("ModelUpdater")
  workspaces       Workspace[]       @relation("WorkspaceCreator")
  workspaceMembers WorkspaceMember[]
  posts            Post[]
  sentInvitations  WorkspaceInvitation[]
}

model Post {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  title     String
  content   String?
  published Boolean  @default(false)
  viewCount Int      @default(0)
  authorId  Int?
  author    User?    @relation(fields: [authorId], references: [id])
}

model ContentModel {
  id          String             @id @default(cuid())
  name        String
  apiId       String
  description String?
  status      ContentModelStatus @default(DRAFT)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  createdBy   Int
  icon        String             @default("box")
  updatedBy   Int?
  fields      ContentField[]
  creator     User               @relation("ModelCreator", fields: [createdBy], references: [id])
  updater     User?              @relation("ModelUpdater", fields: [updatedBy], references: [id])
  workspaceId String?
  workspace   Workspace?         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contents    Content[]

  @@unique([workspaceId, apiId])
}

model Workspace {
  id          String            @id @default(cuid())
  name        String
  description String?
  types       Int               @default(0)
  env         Int               @default(1)
  records     String            @default("0")
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  isDeleted   Boolean           @default(false)
  deletedAt   DateTime?
  createdBy   Int
  creator     User              @relation("WorkspaceCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  models      ContentModel[]
  contents    Content[]
  members     WorkspaceMember[]
  invitations WorkspaceInvitation[]
}

model WorkspaceMember {
  id          String    @id @default(cuid())
  workspaceId String
  userId      Int
  role        String    @default("Developer")
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
}

model WorkspaceInvitation {
  id          String   @id @default(cuid())
  workspaceId String
  email       String
  role        String   @default("Developer")
  token       String   @unique
  status      InvitationStatus @default(PENDING)
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  inviterId   Int
  
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  inviter     User      @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, email, status])
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
  REVOKED
  EXPIRED
}

model ContentField {
  id          String       @id @default(cuid())
  name        String
  type        String
  apiId       String
  localized   Boolean      @default(false)
  required    Boolean      @default(false)
  isTitle     Boolean      @default(false)
  description String?
  modelId     String
  icon        String       @default("text")
  validations Json?
  model       ContentModel @relation(fields: [modelId], references: [id], onDelete: Cascade)
}

model Content {
  id             String       @id @default(cuid())
  workspaceId    String
  workspace      Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contentModelId String
  contentModel   ContentModel @relation(fields: [contentModelId], references: [id], onDelete: Cascade)
  data           Json
  status         String       @default("draft")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([workspaceId])
  @@index([contentModelId])
}

enum ContentModelStatus {
  DRAFT
  LIVE
}
