generator client {
  provider   = "prisma-client"
  output     = "./generated"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  firstName String?
  lastName  String?
  password  String?
  picture   String?
  provider  String
  createdAt DateTime @default(now())
  posts     Post[]
  createdModels ContentModel[] @relation("ModelCreator")
  updatedModels ContentModel[] @relation("ModelUpdater")
}

model Post {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  title     String
  content   String?
  published Boolean  @default(false)
  viewCount Int      @default(0)
  author    User?    @relation(fields: [authorId], references: [id])
  authorId  Int?
}

enum ContentModelStatus {
  DRAFT
  LIVE
}

model ContentModel {
  id          String             @id @default(cuid())
  name        String
  apiId       String             @unique
  description String?
  status      ContentModelStatus @default(DRAFT)
  icon        String             @default("box")
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  createdBy   Int
  creator     User               @relation("ModelCreator", fields: [createdBy], references: [id])
  updatedBy   Int?
  updater     User?              @relation("ModelUpdater", fields: [updatedBy], references: [id])
  fields      ContentField[]
}

model ContentField {
  id          String       @id @default(cuid())
  name        String
  type        String
  apiId       String
  icon        String       @default("text")
  localized   Boolean      @default(false)
  required    Boolean      @default(false)
  isTitle     Boolean      @default(false)
  description String?
  validations Json?
  model       ContentModel @relation(fields: [modelId], references: [id], onDelete: Cascade)
  modelId     String
}
